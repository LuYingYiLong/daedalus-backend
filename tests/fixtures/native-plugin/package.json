{
  "name": "daedalus-fixture-native-plugin",
  "version": "1.0.0",
  "description": "A safe fixture for testing the native plugin runtime.",
  "type": "module",
  "daedalus": {
    "plugin": {
      "apiVersion": 1,
      "entry": "./index.js",
      "capabilities": ["tools", "skills", "hooks", "mcp"],
      "p2": {
        "apiVersion": 1,
        "capabilities": {
          "commands": 1,
          "contextProviders": 1,
          "panels": 1,
          "settings": 1,
          "timelineParts": 1,
          "browser": 1,
          "languageServices": 1,
          "events": 1
        },
        "declarations": {
          "commands": [{ "id": "hello", "command": "/fixture-hello", "description": "Insert a fixture greeting.", "handler": "fixture.command.hello" }],
          "contextProviders": [{ "id": "context", "title": "Fixture context", "description": "Provides a safe fixture context item.", "scopes": ["plugin"], "handler": "fixture.context" }],
          "panels": [{ "panelId": "panel", "title": "Fixture panel", "locations": ["side"], "view": [{ "type": "Text", "text": "Native fixture panel" }] }],
          "settings": [{ "settingsId": "settings", "title": "Fixture settings", "view": [{ "type": "Switch", "id": "enabled", "label": "Enabled" }] }],
          "timelineParts": [{ "partType": "status", "title": "Fixture status" }],
          "browser": { "actions": ["observe", "screenshot"], "handler": "fixture.browser" },
          "languageServices": [{ "id": "fixture", "languageIds": ["fixture"], "extensions": [".fixture"], "command": "fixture-language-service", "capabilities": ["diagnostics"] }],
          "events": [{ "topic": "updates", "publish": true, "subscribe": true }]
        }
      }
    }
  }
}
